# HOME HOST ONLY, in graphene-node. Copy to staging.env and chmod 600.
# Fill the owner wallet ADDRESS, never its private key.
GRAPHENE_STAGE=staging
GRAPHENE_CHAIN_ID=29876
GRAPHENE_HOME_DIRECTORY=/opt/graphene/staging
GRAPHENE_OPERATOR_ADDRESS=
# Only needed during init; at least 32 characters, unique to this stage.
GRAPHENE_HOME_PASSPHRASE=
# Absolute path to the bundle received from ./deploy.sh staging prepare.
# Fill before install, or pass the absolute bundle folder after the install command.
# Do not use ~ or $HOME here; Node env files do not expand them.
GRAPHENE_SETUP_BUNDLE=
