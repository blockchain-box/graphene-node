  "private": true,
  "type": "module",
  "dependencies": {
    "@grph-net/net": "file:./network/net",
    "@grph-net/server": "file:./network/server",
    "@grph-net/utils": "file:./network/utils",
    "b4a": "^1.7.3",
    "hypercore-crypto": "^3.6.1",
    "hyperdht": "^6.27.0",
    "sodium-universal": "^5.0.1",
    "z32": "^1.1.0",
    "ethers": "^6.13.0",
