{
  "name": "@grph/evm-client",
  "version": "1.0.0",
  "description": "Typed SDK for Graphene app-evm — REST, JSON-RPC, and WebSocket access",
  "private": false,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"src/*.test.ts\""
  },
  "dependencies": {
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "tsx": "^4.23.1",
    "typescript": "^5.5.0"
  }
}
